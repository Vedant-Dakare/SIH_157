# SATSA environment template — copy to .env before running.
# cp .env.example .env

# Runtime environment: dev | production (controls default-key startup check)
SATSA_ENV=dev
# Salt used for one-way analyst_id hashing (sha256 + salt). Change before production use.
SATSA_ANALYST_SALT=change-me-in-production-please
# Key used to sign audit manifests/ledger entries. Change before production use.
SATSA_MANIFEST_KEY=change-me-in-production-please
# Air-gap assertion: must remain true; asserts no non-loopback network egress.
SATSA_AIRGAP_ASSERTION=true
# Filesystem roots for data and cached models.
SATSA_DATA_ROOT=data
SATSA_MODELS_ROOT=models
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
SATSA_LOG_LEVEL=INFO
# Default run identifier prefix (a UUID is generated per run if unset).
SATSA_RUN_ID=satsa-local-run
# YAML config file locations (override only if layout differs).
SATSA_CONFIG_DEFAULT=configs/default.yaml
SATSA_CONFIG_SIGNALS=configs/signals.yaml
SATSA_CONFIG_THRESHOLDS=configs/thresholds.yaml
SATSA_CONFIG_LLM=configs/llm.yaml
# LLM backend toggle mirrors configs/llm.yaml (must stay false for air-gapped runs).
SATSA_LLM_ENABLED=false
# Local LLM model path (only used when SATSA_LLM_ENABLED=true).
SATSA_LLM_MODEL_PATH=models/llm/model.gguf
# Ollama server base URL (loopback only; non-loopback hosts are rejected).
SATSA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM generation parameters (only used when LLM is enabled).
SATSA_LLM_TEMPERATURE=0.0
SATSA_LLM_TOP_P=1.0
SATSA_LLM_MAX_TOKENS=512
SATSA_LLM_SEED=42
